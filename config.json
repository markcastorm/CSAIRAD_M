          "description": "Employers, Employers That Started Payroll Deductions",
          "type": "integer"
        },
        {
          "order": 4,
          "pdf_row_label": "Facilitated Deductions in last 90 days",
          "csv_column": "CSAIRAD.EMPLOYERS.FACILITATINGDEDUCTIONS.M",
