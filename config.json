      "current_col_index": 1,
      "fields": [
        {
          "order": 1,
          "pdf_row_label": "Registered",
          "csv_column": "CSAIRAD.EMPLOYERS.REGISTERED.M",
          "description": "Employers, Employers Registered",
          "type": "integer"
        },
        {
          "order": 2,
          "pdf_row_label": "Uploaded Roster",
          "csv_column": "CSAIRAD.EMPLOYERS.UPLOADEDROSTER.M",
